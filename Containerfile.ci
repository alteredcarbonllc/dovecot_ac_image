FROM ubuntu:24.04
RUN groupadd --gid 55004 vmail \
 && useradd --uid 55004 --gid 55004 --home-dir /var/mail --shell /usr/sbin/nologin --no-create-home vmail \
 && groupadd --gid 102 dovecot && groupadd --gid 103 dovenull \
 && useradd --system --uid 100 --gid 102 --home-dir /usr/lib/dovecot --shell /usr/sbin/nologin dovecot \
 && useradd --system --uid 101 --gid 103 --home-dir /nonexistent --shell /usr/sbin/nologin dovenull \
 && printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d \
 && chmod 0755 /usr/sbin/policy-rc.d \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends dovecot-core dovecot-imapd dovecot-pop3d dovecot-lmtpd dovecot-pgsql dovecot-mysql ca-certificates openssl \
 && rm -f /usr/sbin/policy-rc.d \
 \
 && rm -rf /var/lib/apt/lists/* \
 && test "$(id -u dovecot):$(id -g dovecot):$(id -u dovenull):$(id -g dovenull)" = 100:102:101:103 \
 && test "$(id -u vmail):$(id -g vmail)" = 55004:55004 \
 && install -d -o vmail -g vmail -m 0700 /var/mail \
 && mkdir -p /usr/local/share/ac-mail /var/log/dovecot \
 && dpkg-query -W > /usr/local/share/ac-mail/packages.txt \
 && dovecot --version > /usr/local/share/ac-mail/version.txt
LABEL org.opencontainers.image.title="AC dovecot"       org.opencontainers.image.source="https://github.com/alteredcarbonllc/dovecot_ac_image"
EXPOSE 993 995 24 40000
STOPSIGNAL SIGTERM
USER root
WORKDIR /
CMD ["dovecot", "-F"]
